# Zerodha Kite Connect API Credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=your_access_token_here
KITE_PUBLIC_TOKEN=your_public_token_here

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# VPS / Heaven Cloud Administration
VPS_STATIC_IP=your_vps_ip_here
VPS_PORT=8002
VPS_USER=root
VPS_REMOTE_DIR=/root/nifty_3point_algo

# Trading Environment Mode (DEFAULT: PAPER, NEVER SILENTLY SWITCH TO LIVE)
TRADING_MODE=PAPER
LIVE_EXECUTION_ENABLED=false
OPERATOR_APPROVAL_TOKEN=
